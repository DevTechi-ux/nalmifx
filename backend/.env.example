# Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Configuration
# For local: mongodb://localhost:27017/nalmifx
# For production: Atlas SRV only on the server — copy this file to .env on the VPS (do not commit .env).
# The path after .net/ is the database name (e.g. ...mongodb.net/nalmifx) — wrong name = wrong/empty data.
MONGODB_URI=mongodb://localhost:27017/nalmifx

# JWT Secret - Generate a secure random string for production
JWT_SECRET=your_secure_jwt_secret_here

# CORS Configuration - comma-separated list of allowed frontend origins.
# Include BOTH apex and www in production — they are different origins to the
# browser and must each be on the allow-list, or the browser raises a CORS error.
# Variable name must be CORS_ORIGINS (plural) — server.js reads CORS_ORIGINS.
CORS_ORIGINS=https://nalmifx.com,https://www.nalmifx.com,https://api.nalmifx.com

# SMTP Configuration (optional - for email functionality)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM_NAME=NalmiFX
# SMTP_FROM_EMAIL=noreply@nalmifx.com

# Infoway.io API Configuration (Required for price feeds)
# Get your API key from https://infoway.io
# Documentation: https://docs.infoway.io/en-docs/rest-api/websocket
INFOWAY_API_KEY=your_infoway_api_key_here
